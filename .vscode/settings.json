{
  // ---- Solidity: 저장할 때마다 forge fmt로 자동 정리 ----
  // NomicFoundation 확장(Solidity by Nomic Foundation)이 foundry.toml의 [fmt] 설정을 읽어 forge fmt를 실행한다.
  "[solidity]": {
    "editor.defaultFormatter": "NomicFoundation.hardhat-solidity",
    "editor.formatOnSave": true
  },
  "solidity.formatter": "forge",

  // ---- 주석 전체 스타일 (이 저장소에서만 적용) ----
  // 코드와 구분되게 부드러운 초록 + 이탤릭으로 칠한다.
  "editor.tokenColorCustomizations": {
    "comments": {
      "foreground": "#7FA88A",
      "fontStyle": "italic"
    }
  },

  // ---- Better Comments 확장: 주석 앞 기호에 따라 색을 다르게 ----
  //   // ! 경고·보안 핵심   → 빨강
  //   // ? 질문·생각해볼 것 → 파랑
  //   // * 중요한 설명       → 노랑
  //   // TODO 할 일          → 주황
  "better-comments.tags": [
    { "tag": "!", "color": "#FF6B6B", "strikethrough": false, "underline": false, "backgroundColor": "transparent", "bold": true, "italic": false },
    { "tag": "?", "color": "#5AA9FF", "strikethrough": false, "underline": false, "backgroundColor": "transparent", "bold": false, "italic": false },
    { "tag": "*", "color": "#FFC93C", "strikethrough": false, "underline": false, "backgroundColor": "transparent", "bold": false, "italic": false },
    { "tag": "todo", "color": "#FF9F43", "strikethrough": false, "underline": false, "backgroundColor": "transparent", "bold": true, "italic": false }
  ],
  "better-comments.multilineComments": true,

  // ---- Tailwind CSS ----
  // VSCode 기본 CSS 검사기는 Tailwind 문법(@theme 등)을 몰라서 "Unknown at rule" 경고를 낸다.
  // .css 파일을 Tailwind 확장의 언어 모드로 열게 해서 경고를 없애고 자동완성을 켠다.
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
