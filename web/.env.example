# 이 파일을 복사해서 web/.env.local을 만든다:  cp .env.example .env.local
# .env.local은 커밋하지 않는다 (.gitignore). 이 예시 파일만 커밋한다.
# NEXT_PUBLIC_ 으로 시작하는 값은 브라우저 코드에 그대로 박힌다. 비밀값에는 절대 붙이지 않는다.

# 31337 = 로컬 anvil, 84532 = Base Sepolia, 8453 = Base 메인넷
NEXT_PUBLIC_CHAIN_ID=31337
# 비워 두면 체인 내장 RPC를 쓴다 (anvil = http://127.0.0.1:8545). Base Sepolia는 Alchemy 등 RPC 주소를 넣는다.
NEXT_PUBLIC_RPC_URL=
# WalletConnect(Reown) 프로젝트 ID. 비워 두면 RainbowKit 개발용 예제 ID를 쓴다. 배포 전에 https://cloud.reown.com 에서 받는다.
NEXT_PUBLIC_WC_PROJECT_ID=
# contracts에서 `forge script script/Deploy.s.sol ... --broadcast` 출력값을 그대로 붙인다
NEXT_PUBLIC_PET_NFT_ADDRESS=
NEXT_PUBLIC_ENERGY_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
# 메타데이터 이미지 URL에 쓰는 앱 주소
NEXT_PUBLIC_APP_URL=http://localhost:3000
# (선택, 서버 전용) 가스비 대납 Paymaster URL. NEXT_PUBLIC_을 붙이지 않는다.
PAYMASTER_URL=
